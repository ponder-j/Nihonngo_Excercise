{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kana Loop vocabulary library v1",
  "type": "object",
  "required": ["version", "units"],
  "properties": {
    "version": { "const": 1 },
    "units": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "required": ["id", "name", "kind", "words"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$", "not": { "const": "kana" } },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "const": "vocabulary" },
          "words": {
            "type": "array", "maxItems": 5000,
            "items": {
              "type": "object", "required": ["id", "japanese", "kana", "accent", "meaning"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
                "japanese": { "type": "string", "minLength": 1 },
                "kana": { "type": "string", "minLength": 1 },
                "accent": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "meaning": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
